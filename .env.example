# Copy this file to .env and fill in the values. Never commit .env.

# PayPal SANDBOX app (developer.paypal.com > Apps & Credentials > Sandbox).
# The code only talks to the sandbox; live keys will not work.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Webhook ID from the same sandbox app's Webhooks section.
# Needed to verify that incoming webhooks really come from PayPal.
PAYPAL_WEBHOOK_ID=

# Local development only: skip webhook signature checks (for PayPal's webhook
# simulator, whose test events cannot be verified). Ignored in production.
WEBHOOK_SKIP_VERIFY=false

# Google Gemini API key, free tier (aistudio.google.com > Get API key).
GEMINI_API_KEY=
# Check AI Studio for the current free Flash model name and change this if needed.
GEMINI_MODEL=gemini-3.5-flash
# Backups tried in order when the main model is busy or retired.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview

# Public URL of this app, used as the PayPal return URL for test payments.
APP_BASE_URL=http://localhost:3000

# Real sandbox disputes to re-import on every start, comma-separated (for Render,
# whose disk is wiped on restart). Disputes already in seed/snapshot.json are
# re-imported anyway.
PAYPAL_DISPUTE_IDS=

# Optional site password (any username). Leave empty locally.
APP_PASSWORD=
