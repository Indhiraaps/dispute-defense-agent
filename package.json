{
  "name": "dispute-defense-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI agent that helps small PayPal sellers decide whether to fight a dispute, then builds and submits cited evidence with human approval.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "spike:keys": "tsx scripts/spike/01-check-keys.ts",
    "spike:payment": "tsx scripts/spike/02-create-test-payment.ts",
    "spike:inspect": "tsx scripts/spike/03-inspect-dispute.ts",
    "spike:evidence": "tsx scripts/spike/04-test-evidence.ts",
    "spike:action": "tsx scripts/spike/05-dispute-action.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "sync": "tsx scripts/sync-disputes.ts",
    "collect": "tsx scripts/collect.ts",
    "demo:photos": "tsx scripts/make-demo-photos.ts",
    "agent": "tsx scripts/run-agent.ts",
    "draft": "tsx scripts/draft.ts",
    "test": "tsx --test tests/*.test.ts",
    "packet": "tsx scripts/packet.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "spike:wait-decision": "tsx scripts/spike/06-wait-adjudicate.ts",
    "snapshot": "tsx scripts/snapshot.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.118",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "ai": "^7.0.170",
    "better-sqlite3": "^13.1.1",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
